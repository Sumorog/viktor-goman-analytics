# %% [markdown]
# # Анализ дебиторской задолженности
# 
# Цель: сократить просрочку на 35% через автоматизацию уведомлений
# 
# Исходные данные: выгрузка из 1С (обезличены)

# %%
import pandas as pd
import numpy as np
from datetime import datetime, timedelta
import matplotlib.pyplot as plt

# TODO: настроить нормальные графики, пока дефолтные
# plt.style.use('seaborn')  # не работает в новых версиях

# %%
# Загрузка
df = pd.read_excel('debt_data_2022.xlsx')

# Проверка
print(f"Всего записей: {len(df)}")
print(f"Период: {df['date'].min()} - {df['date'].max()}")
print(f"Уникальных контрагентов: {df['contractor_id'].nunique()}")

# %%
# Сегментация по просрочке
def categorize_delay(days):
    if days <= 0:
        return 'current'
    elif days <= 30:
        return '1-30'
    elif days <= 90:
        return '31-90'
    else:
        return '90+'

df['delay_category'] = df['delay_days'].apply(categorize_delay)

# Сводка
summary = df.groupby('delay_category').agg({
    'amount': 'sum',
    'contractor_id': 'nunique'
}).round(2)

summary['share'] = (summary['amount'] / summary['amount'].sum() * 100).round(1)
print(summary)

# %%
# Прогноз: как изменится структура через 6 месяцев при автоматизации
# Гипотеза: автоматические уведомления сокращают просрочку 1-30 на 50%, 31-90 на 30%

current = summary.copy()
forecast = current.copy()

# коэффициенты эффекта (по результатам пилота)
effect = {
    'current': 1.0,
    '1-30': 0.5,    # сокращаем вдвое
    '31-90': 0.7,   # сокращаем на 30%
    '90+': 1.0      # здесь уже поздно, работаем через суд
}

for cat in forecast.index:
    forecast.loc[cat, 'amount'] *= effect[cat]

forecast['share'] = (forecast['amount'] / forecast['amount'].sum() * 100).round(1)

print("\n=== ПРОГНОЗ ===")
print(forecast)

